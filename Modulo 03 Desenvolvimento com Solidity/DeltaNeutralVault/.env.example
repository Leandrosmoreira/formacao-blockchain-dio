# Private Key da carteira (NUNCA compartilhe!)
PRIVATE_KEY=0x1234567890abcdef...

# RPC URL da rede Airbithon
AIRBITHON_RPC_URL=https://rpc.airbithon.network

# Chain ID da rede Airbithon (ajuste conforme documentação)
AIRBITHON_CHAIN_ID=123456

# Opcional: Alchemy API Key (para Sepolia/Mainnet)
ALCHEMY_API_KEY=your_alchemy_key_here

# Opcional: Etherscan API Key (para verificação de contrato)
ETHERSCAN_API_KEY=your_etherscan_key_here
