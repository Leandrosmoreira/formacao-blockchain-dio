# Solana RPC Endpoints
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WSS_URL=wss://api.devnet.solana.com

# For production, use a premium RPC like Helius or QuickNode
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Vault Configuration
VAULT_ADDRESS=
KEEPER_KEYPAIR_PATH=./keypairs/keeper.json

# Pyth Network
# SOL/USD price feed (devnet)
PYTH_PRICE_ID=J83w4HKfqxwcq3BEMMkPFSppX3gqekLyLJBexebFVkix
# For mainnet, use: H6ARHf6YXhGYeQfUzQNGk6rDNnLBQKrenN712K4AQJEG

# Keeper Strategy Parameters
DEADBAND_BPS=50              # 0.5% deadband for hysteresis
TWAP_WINDOW_SECS=60          # 60 seconds TWAP window
COOLDOWN_MS=180000           # 3 minutes cooldown (180000ms)
CHECK_INTERVAL_MS=5000       # Check price every 5 seconds

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Orca Whirlpool
# Example: SOL/USDC pool on devnet
WHIRLPOOL_POOL_ID=

# Logging
LOG_LEVEL=info               # trace, debug, info, warn, error
